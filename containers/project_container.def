Bootstrap: docker
From: ubuntu:22.04

%files
    ../requirements.txt /opt/requirements.txt

%post -c /bin/bash
    # Python 3.12.3 is not avaibable in the apt package manager on ubuntu:22.04
    # Python 3.12.3 installation uses pyenv
    # https://github.com/pyenv/pyenv#installation
    # https://github.com/pyenv/pyenv/wiki

    # https://lindevs.com/install-packages-non-interactively-using-apt
    export DEBIAN_FRONTEND=noninteractive
    # Add pyenv to path
    export PYENV_ROOT="/opt/.pyenv"
    export PATH="$PYENV_ROOT/bin:$PATH"

    apt-get update

    apt-get install -y \
        make \
        build-essential \
        libssl-dev \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        curl \
        git \
        libncursesw5-dev \
        xz-utils \
        tk-dev \
        libxml2-dev \
        libxmlsec1-dev \
        libffi-dev \
        liblzma-dev \
        libzstd-dev

    git clone https://github.com/pyenv/pyenv.git "$PYENV_ROOT"

    eval "$(pyenv init - bash)"

    pyenv install 3.12.3
    pyenv global 3.12.3

    python -m pip install --upgrade pip

    python -m pip install -r /opt/requirements.txt

%test
    python --version | grep "Python 3.12.3"
    python3 --version | grep "Python 3.12.3"

%environment
    # Add pyenv to path
    export PYENV_ROOT="/opt/.pyenv"
    export PATH="$PYENV_ROOT/versions/3.12.3/bin:$PYENV_ROOT/bin:$PATH"

%help
    This is the container used for training the EfficientNetV2-s